{
  "name": "kayford-performance-web",
  "version": "0.1.0",
  "description": "孚德智能绩效管理系统 前端（Vue3 + Element Plus）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:contracts": "vue-tsc --noEmit -p tsconfig.contracts.json && playwright test --config playwright.contract.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "dingtalk-jsapi": "3.2.9",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/core": "^11.1.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.60.0",
    "typescript": "^5.6.2",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
