# ── 应用 ──────────────────────────────────────────
APP_NAME=kayford-performance
NODE_ENV=production

# ── 后端 ──────────────────────────────────────────
API_PORT=3000
API_PREFIX=/api/v1
JWT_SECRET=请替换为64位随机字符串_openssl_rand_base64_48
JWT_EXPIRES_IN=8h
# 员工身份证与银行账号字段加密密钥；生产环境请单独生成，未配置时暂以 JWT_SECRET 派生
EMPLOYEE_ARCHIVE_ENCRYPTION_KEY=

# AI 服务凭据专用主密钥：独立生成的 32 字节随机值，以标准 Base64 编码。
# 不复用 JWT、员工档案或服务商 API Key；缺失/无效时 AI 机器人保持关闭。
# 更换此密钥前须制定凭据重新录入方案；旧密文无法用新密钥解密。
AI_PROVIDER_ENCRYPTION_KEY=

# ── PostgreSQL ────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kayford_perf
POSTGRES_USER=kayford
POSTGRES_PASSWORD=请替换为强密码

# Prisma 使用（后端容器内）
DATABASE_URL=postgresql://kayford:请替换为强密码@postgres:5432/kayford_perf

# ── Redis ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=请替换为Redis密码
REDIS_URL=redis://:请替换为Redis密码@redis:6379

# ── MinIO ─────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=请替换为AccessKey
MINIO_SECRET_KEY=请替换为SecretKey_至少8位
MINIO_BUCKET=kayford-perf
MINIO_USE_SSL=false

# ── 钉钉 ──────────────────────────────────────────
DINGTALK_APP_KEY=请填写钉钉应用AppKey
DINGTALK_APP_SECRET=请填写钉钉应用AppSecret
DINGTALK_CORP_ID=请填写企业CorpId
DINGTALK_AGENT_ID=请填写消息推送AgentId
DINGTALK_NOTIFICATION_ENABLED=false
# 进展助手独立开关；还须在 AI 服务配置中测试/启用服务商和机器人。
DINGTALK_BOT_STREAM_ENABLED=false
# 机器人独立企业内部应用凭证。HRM 登录与通讯录身份核验仍使用上面的 DINGTALK_APP_KEY/SECRET。
DINGTALK_BOT_APP_KEY=
DINGTALK_BOT_APP_SECRET=
# Task 9 现场确认机器人应用、Stream、卡片模板和单聊发送权限后才设 true。
DINGTALK_BOT_PREFLIGHT_CONFIRMED=false
# Stream 回调 headers.appId 的应用标识（不是 ClientID/AppKey 或 AgentId；以该应用实际回调值为准）。
DINGTALK_BOT_STREAM_APP_ID=
DINGTALK_BOT_CARD_TEMPLATE_ID=
# 可选：主动查询四类卡片；未配置时同一试点机器人返回安全文字入口
DINGTALK_BOT_TODO_TEMPLATE_ID=
DINGTALK_BOT_GOAL_TEMPLATE_ID=
DINGTALK_BOT_EVALUATION_TEMPLATE_ID=
DINGTALK_BOT_RESULT_TEMPLATE_ID=
# HRM 的 HTTPS origin；确认页仍需登录，链接本身不是授权。
DINGTALK_BOT_HRM_URL=
DINGTALK_REDIRECT_URI=https://perf.kayford.com/auth/callback

# ── 可选：Seed ────────────────────────────────────
# 设置后执行 `npx prisma db seed` 会自动创建 employeeNo=ADMIN 的测试管理员
# SEED_ADMIN_PASSWORD=your_admin_password
# 以下测试能力默认关闭；演示密码只在执行 seed 时通过运行时环境变量提供
ENABLE_DEMO_HISTORY_SEED=false
DEMO_HISTORY_ACCOUNT_PASSWORD=
ENABLE_TEST_QUICK_LOGIN=false

# ── 前端构建 ──────────────────────────────────────
VITE_API_BASE_URL=https://perf.kayford.com   # 生产域名
# VITE_API_BASE_URL=http://localhost:3000    # 开发时替换此行
