// ---------------------------------------------------------------------------
// 核心业务表
// ---------------------------------------------------------------------------

model Department {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dingtalkDeptId String?     @unique @map("dingtalk_dept_id") @db.VarChar(64)
  name           String      @db.VarChar(100)
  fullPath       String?     @map("full_path") @db.VarChar(500)
  parentId       String?     @map("parent_id") @db.Uuid
  leaderId       String?     @map("leader_id") @db.Uuid
  approverId     String?     @map("approver_id") @db.Uuid
  company        CompanyCode @default(fuede)
  sortOrder      Int         @default(0) @map("sort_order")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  parent                         Department?                     @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                       Department[]                    @relation("DeptTree")
  leader                         User?                           @relation("DeptLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  approver                       User?                           @relation("DeptApprover", fields: [approverId], references: [id], onDelete: SetNull)
  members                        User[]                          @relation("DeptMembers")
  tasks                          AssessmentTask[]
  objectives                     Objective[]                     @relation("ObjectiveDepartment")
  indicatorVisibilityDepartments IndicatorVisibilityDepartment[]
  employmentRecords              EmploymentRecord[]
  changeRequests                 DepartmentChangeRequest[]

  @@index([parentId])
  @@index([approverId])
  @@index([leaderId])
  @@index([company])
  @@map("departments")
}

model DepartmentChangeRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  departmentName String    @map("department_name") @db.VarChar(100)
  action         String    @db.VarChar(30)
  status         String    @default("pending") @db.VarChar(20)
  baseValue      Json      @default("{}") @map("base_value") @db.JsonB
  proposedValue  Json      @map("proposed_value") @db.JsonB
  createdById    String    @map("created_by_id") @db.Uuid
  reviewedById   String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectedReason String?   @map("rejected_reason") @db.Text
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("DepartmentChangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?       @relation("DepartmentChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([departmentId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@map("department_change_requests")
}

model Position {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  jobFamily   String?  @map("job_family") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  users             User[]                  @relation("UserPosition")
  employmentRecords EmploymentRecord[]
  changeRequests    PositionChangeRequest[]

  @@index([name, isActive])
  @@index([jobFamily, isActive])
  @@map("positions")
}

model PositionChangeRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  positionId     String?   @map("position_id") @db.Uuid
  positionName   String    @map("position_name") @db.VarChar(100)
  action         String    @db.VarChar(30)
  status         String    @default("pending") @db.VarChar(20)
  baseValue      Json      @default("{}") @map("base_value") @db.JsonB
  proposedValue  Json      @map("proposed_value") @db.JsonB
  warnings       Json      @default("[]") @db.JsonB
  createdById    String    @map("created_by_id") @db.Uuid
  reviewedById   String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectedReason String?   @map("rejected_reason") @db.Text
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  position  Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdBy User      @relation("PositionChangeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?    @relation("PositionChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([positionId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@map("position_change_requests")
}

model User {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dingtalkId         String?        @unique @map("dingtalk_id") @db.VarChar(64)
  dingtalkUnionId    String?        @unique @map("dingtalk_union_id") @db.VarChar(64)
  name               String         @db.VarChar(50)
  employeeNo         String?        @unique @map("employee_no") @db.VarChar(30)
  phone              String?        @db.VarChar(20)
  email              String?        @db.VarChar(100)
  avatarUrl          String?        @map("avatar_url") @db.VarChar(500)
  passwordHash       String?        @map("password_hash") @db.VarChar(100) // 降级方案：账号密码登录
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  hrCapabilities     String[]       @default([]) @map("hr_capabilities") @db.VarChar(60)
  deptId             String?        @map("dept_id") @db.Uuid
  positionId         String?        @map("position_id") @db.Uuid
  position           String?        @db.VarChar(100)
  entryDate          DateTime?      @map("entry_date") @db.Date
  plannedRegularDate DateTime?      @map("planned_regular_date") @db.Date
  actualRegularDate  DateTime?      @map("actual_regular_date") @db.Date
  accountType        AccountType    @default(employee) @map("account_type")
  leaveDate          DateTime?      @map("leave_date") @db.Date // 离职日期，用于在岗豁免计算（修正项）
  employmentType     EmploymentType @default(full_time) @map("employment_type")
  status             UserStatus     @default(active)
  directManagerId    String?        @map("direct_manager_id") @db.Uuid
  dingtalkManagerId  String?        @map("dingtalk_manager_id") @db.VarChar(64)
  sysRole            SysRole        @default(employee) @map("sys_role")
  isAssessorOnly     Boolean        @default(false) @map("is_assessor_only")
  canViewAll         Boolean        @default(false) @map("can_view_all") // 全量只读（董事长李宏=true，审批权另由 approver_id 决定）
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  dept          Department? @relation("DeptMembers", fields: [deptId], references: [id], onDelete: SetNull)
  positionRef   Position?   @relation("UserPosition", fields: [positionId], references: [id], onDelete: SetNull)
  directManager User?       @relation("UserManager", fields: [directManagerId], references: [id], onDelete: SetNull)
  subordinates  User[]      @relation("UserManager")

  ledDepartments                            Department[]                     @relation("DeptLeader")
  approvedDepartments                       Department[]                     @relation("DeptApprover")
  createdIndicators                         Indicator[]
  createdTemplates                          AssessmentTemplate[]
  createdCycles                             AssessmentCycle[]                @relation("CycleCreator")
  hrOwnedCycles                             AssessmentCycle[]                @relation("CycleHrOwner")
  reviewedCycles                            AssessmentCycle[]                @relation("CycleReviewer")
  companyFinalApproverCycles                AssessmentCycle[]                @relation("CycleCompanyFinalApprover")
  employeeTasks                             AssessmentTask[]                 @relation("TaskEmployee")
  managedTasks                              AssessmentTask[]                 @relation("TaskManager")
  deptHeadTasks                             AssessmentTask[]                 @relation("TaskDeptHead")
  approverTasks                             AssessmentTask[]                 @relation("TaskApprover")
  vetoedResults                             GradeResult[]                    @relation("GradeVetoOperator")
  calibratedResults                         GradeResult[]                    @relation("GradeHrCalibrator")
  approvedResults                           GradeResult[]                    @relation("GradeApprover")
  flowRecords                               FlowRecord[]
  indicatorVisibilityUsers                  IndicatorVisibilityUser[]
  appeals                                   Appeal[]                         @relation("AppealAppellant")
  deptResolvedAppeals                       Appeal[]                         @relation("AppealDeptResolver")
  hrResolvedAppeals                         Appeal[]                         @relation("AppealHrResolver")
  archives                                  PerformanceArchive[]
  improvementPlans                          ImprovementPlan[]                @relation("ImprovementPlanEmployee")
  createdImprovementPlans                   ImprovementPlan[]                @relation("ImprovementPlanCreator")
  auditLogs                                 AuditLog[]
  signatures                                Signature[]
  interviewedAsEmployee                     PerformanceInterview[]           @relation("InterviewEmployee")
  interviewedAsInterviewer                  PerformanceInterview[]           @relation("InterviewInterviewer")
  probationReviewsAsEmployee                ProbationReview[]                @relation("ProbationReviewEmployee")
  probationReviewsAsManager                 ProbationReview[]                @relation("ProbationReviewManager")
  probationReviewsAsHr                      ProbationReview[]                @relation("ProbationReviewHr")
  createdProbationReviews                   ProbationReview[]                @relation("ProbationReviewCreator")
  confirmationApplicationsAsEmployee        ConfirmationApplication[]        @relation("ConfirmationApplicationEmployee")
  confirmationApplicationsAsManager         ConfirmationApplication[]        @relation("ConfirmationApplicationManager")
  confirmationApplicationsAsHr              ConfirmationApplication[]        @relation("ConfirmationApplicationHr")
  confirmationApplicationsAsCompanyApprover ConfirmationApplication[]        @relation("ConfirmationApplicationCompanyApprover")
  confirmationApplicationsRejected          ConfirmationApplication[]        @relation("ConfirmationApplicationRejectedBy")
  createdConfirmationApplications           ConfirmationApplication[]        @relation("ConfirmationApplicationCreator")
  ownedObjectives                           Objective[]                      @relation("ObjectiveOwner")
  createdObjectives                         Objective[]                      @relation("ObjectiveCreator")
  reviewedObjectives                        Objective[]                      @relation("ObjectiveReviewer")
  assignedActionItems                       ActionItem[]                     @relation("ActionItemAssignee")
  createdActionItems                        ActionItem[]                     @relation("ActionItemCreator")
  createdIndicatorProgressUpdates           IndicatorProgressUpdate[]        @relation("IndicatorProgressCreator")
  managedAssessmentPeriods                  AssessmentPeriod[]               @relation("PeriodManager")
  createdIndicatorVersions                  IndicatorVersion[]               @relation("IndicatorVersionCreator")
  createdPeriodReviewRevisions              AssessmentPeriodReviewRevision[] @relation("PeriodReviewRevisionCreator")
  updatedConfigs                            SystemConfig[]
  notifications                             NotificationLog[]                @relation("NotifReceiver")
  sentNotifications                         NotificationLog[]                @relation("NotifSender")
  employeeProfile                           EmployeeProfile?
  employmentHistory                         EmploymentRecord[]               @relation("EmployeeEmployment")
  managedEmploymentHistory                  EmploymentRecord[]               @relation("EmploymentManager")
  createdEmploymentHistory                  EmploymentRecord[]               @relation("EmploymentCreator")
  externalIdentityBindings                  ExternalIdentityBinding[]        @relation("ExternalIdentityEmployee")
  boundExternalIdentities                   ExternalIdentityBinding[]        @relation("ExternalIdentityBoundBy")
  disabledExternalIdentities                ExternalIdentityBinding[]        @relation("ExternalIdentityDisabledBy")
  endedExternalIdentities                   ExternalIdentityBinding[]        @relation("ExternalIdentityEndedBy")
  operatedEmployeeImports                   EmployeeImportBatch[]            @relation("EmployeeImportOperator")
  confirmedEmployeeImports                  EmployeeImportBatch[]            @relation("EmployeeImportConfirmer")
  matchedEmployeeImportRows                 EmployeeImportRow[]
  employeeChangeRequests                    EmployeeDataChangeRequest[]      @relation("EmployeeChangeSubject")
  createdEmployeeChangeRequests             EmployeeDataChangeRequest[]      @relation("EmployeeChangeCreatedBy")
  profileReviewedEmployeeChanges            EmployeeDataChangeRequest[]      @relation("EmployeeProfileReviewedBy")
  performanceReviewedEmployeeChanges        EmployeeDataChangeRequest[]      @relation("EmployeePerformanceReviewedBy")
  employeeContracts                         EmployeeContract[]               @relation("EmployeeContractOwner")
  createdEmployeeContracts                  EmployeeContract[]               @relation("EmployeeContractCreator")
  createdDepartmentChangeRequests           DepartmentChangeRequest[]        @relation("DepartmentChangeCreatedBy")
  reviewedDepartmentChangeRequests          DepartmentChangeRequest[]        @relation("DepartmentChangeReviewedBy")
  createdPositionChangeRequests             PositionChangeRequest[]          @relation("PositionChangeCreatedBy")
  reviewedPositionChangeRequests            PositionChangeRequest[]          @relation("PositionChangeReviewedBy")

  @@index([deptId])
  @@index([positionId])
  @@index([directManagerId])
  @@index([status])
  @@index([accountType])
  @@index([dingtalkId])
  @@map("users")
}

model EmployeeProfile {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  phone                    String?   @db.VarChar(20)
  gender                   String?   @db.VarChar(20)
  birthDate                DateTime? @map("birth_date") @db.Date
  ethnicity                String?   @db.VarChar(50)
  education                String?   @db.VarChar(50)
  professionalTitle        String?   @map("professional_title") @db.VarChar(100)
  school                   String?   @db.VarChar(200)
  graduationDate           DateTime? @map("graduation_date") @db.Date
  major                    String?   @db.VarChar(150)
  maritalStatus            String?   @map("marital_status") @db.VarChar(30)
  childrenStatus           String?   @map("children_status") @db.VarChar(30)
  childrenCount            Int?      @map("children_count")
  politicalStatus          String?   @map("political_status") @db.VarChar(50)
  nativePlace              String?   @map("native_place") @db.VarChar(150)
  householdType            String?   @map("household_type") @db.VarChar(100)
  idAddress                String?   @map("id_address") @db.Text
  idNumberEncrypted        Bytes?    @map("id_number_encrypted") @db.ByteA
  idNumberFingerprint      String?   @map("id_number_fingerprint") @db.VarChar(128)
  currentAddress           String?   @map("current_address") @db.Text
  emergencyContactName     String?   @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactRelation String?   @map("emergency_contact_relation") @db.VarChar(50)
  emergencyContactPhone    String?   @map("emergency_contact_phone") @db.VarChar(30)
  socialSecurityStatus     String?   @map("social_security_status") @db.VarChar(100)
  socialSecurityStartDate  DateTime? @map("social_security_start_date") @db.Date
  housingFundStatus        String?   @map("housing_fund_status") @db.VarChar(100)
  housingFundStartDate     DateTime? @map("housing_fund_start_date") @db.Date
  bankName                 String?   @map("bank_name") @db.VarChar(100)
  bankBranch               String?   @map("bank_branch") @db.VarChar(200)
  bankAccountEncrypted     Bytes?    @map("bank_account_encrypted") @db.ByteA
  bankAccountFingerprint   String?   @map("bank_account_fingerprint") @db.VarChar(128)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("employee_profiles")
}

model EmployeeContract {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  contractType             String    @map("contract_type") @db.VarChar(30)
  sequence                 Int       @default(0)
  name                     String?   @db.VarChar(150)
  signingCompany           String?   @map("signing_company") @db.VarChar(150)
  signedAt                 DateTime? @map("signed_at") @db.Date
  effectiveFrom            DateTime? @map("effective_from") @db.Date
  expiresAt                DateTime? @map("expires_at") @db.Date
  termType                 String?   @map("term_type") @db.VarChar(100)
  originalCompany          String?   @map("original_company") @db.VarChar(150)
  newCompany               String?   @map("new_company") @db.VarChar(150)
  confidentialityAgreement String?   @map("confidentiality_agreement") @db.VarChar(50)
  nonCompeteAgreement      String?   @map("non_compete_agreement") @db.VarChar(50)
  portraitAgreement        String?   @map("portrait_agreement") @db.VarChar(50)
  isActive                 Boolean   @default(true) @map("is_active")
  endedAt                  DateTime? @map("ended_at") @db.Timestamptz(6)
  attachmentRef            String?   @map("attachment_ref") @db.VarChar(500)
  images                   Json      @default("[]") @db.JsonB
  attachments              Json      @default("[]") @db.JsonB
  sourceBatchId            String?   @map("source_batch_id") @db.Uuid
  createdById              String?   @map("created_by_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user      User  @relation("EmployeeContractOwner", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User? @relation("EmployeeContractCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([userId, isActive, expiresAt])
  @@index([sourceBatchId])
  @@map("employee_contracts")
}

model EmploymentRecord {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  effectiveFrom      DateTime       @map("effective_from") @db.Date
  effectiveTo        DateTime?      @map("effective_to") @db.Date
  company            CompanyCode
  deptId             String?        @map("dept_id") @db.Uuid
  positionId         String?        @map("position_id") @db.Uuid
  position           String?        @db.VarChar(100)
  jobGrade           String?        @map("job_grade") @db.VarChar(30)
  jobFamily          String?        @map("job_family") @db.VarChar(100)
  directManagerId    String?        @map("direct_manager_id") @db.Uuid
  workLocation       String?        @map("work_location") @db.VarChar(100)
  employmentType     EmploymentType @default(full_time) @map("employment_type")
  employeeStatus     UserStatus     @default(active) @map("employee_status")
  entryDate          DateTime?      @map("entry_date") @db.Date
