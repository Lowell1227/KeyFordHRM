  @@index([probationReviewId])
  @@map("probation_review_indicators")
}

model ConfirmationApplication {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  probationReviewId String?            @map("probation_review_id") @db.Uuid
  managerId         String             @map("manager_id") @db.Uuid
  hrId              String             @map("hr_id") @db.Uuid
  companyApproverId String             @map("company_approver_id") @db.Uuid
  status            ConfirmationStatus @default(draft)
  summary           String?            @db.Text
  salary            Decimal?           @db.Decimal(12, 2)
  voteResult        VoteResult?        @map("vote_result")
  voteParticipants  Json               @default("[]") @map("vote_participants") @db.JsonB
  voteComment       String?            @map("vote_comment") @db.Text
  voteMeetingTime   DateTime?          @map("vote_meeting_time") @db.Timestamptz(6)
  managerComment    String?            @map("manager_comment") @db.Text
  managerApprovedAt DateTime?          @map("manager_approved_at") @db.Timestamptz(6)
  hrComment         String?            @map("hr_comment") @db.Text
  hrApprovedAt      DateTime?          @map("hr_approved_at") @db.Timestamptz(6)
  companyComment    String?            @map("company_comment") @db.Text
  companyApprovedAt DateTime?          @map("company_approved_at") @db.Timestamptz(6)
  rejectedById      String?            @map("rejected_by_id") @db.Uuid
  rejectedAt        DateTime?          @map("rejected_at") @db.Timestamptz(6)
  rejectReason      String?            @map("reject_reason") @db.Text
  actualRegularDate DateTime?          @map("actual_regular_date") @db.Date
  createdBy         String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  employee        User             @relation("ConfirmationApplicationEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  manager         User             @relation("ConfirmationApplicationManager", fields: [managerId], references: [id], onDelete: Restrict)
  hr              User             @relation("ConfirmationApplicationHr", fields: [hrId], references: [id], onDelete: Restrict)
  companyApprover User             @relation("ConfirmationApplicationCompanyApprover", fields: [companyApproverId], references: [id], onDelete: Restrict)
  rejectedBy      User?            @relation("ConfirmationApplicationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  creator         User?            @relation("ConfirmationApplicationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  probationReview ProbationReview? @relation(fields: [probationReviewId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([managerId])
  @@index([hrId])
  @@index([companyApproverId])
  @@index([status])
  @@index([probationReviewId])
  @@index([createdBy])
  @@map("confirmation_applications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value") @db.JsonB
  newValue   Json?    @map("new_value") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Signature {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessType     SignatureBusinessType @map("business_type")
  businessRecordId String                @map("business_record_id") @db.Uuid
  role             SignatureRole
  signerId         String                @map("signer_id") @db.Uuid
  signedAt         DateTime              @default(now()) @map("signed_at") @db.Timestamptz(6)
  method           SignatureMethod       @default(online_confirm) @map("method")
  idempotencyKey   String?               @map("idempotency_key") @db.VarChar(64)
  imageUrl         String?               @map("image_url") @db.VarChar(500)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  signer User @relation(fields: [signerId], references: [id], onDelete: Restrict)

  @@unique([businessType, businessRecordId, role])
  @@index([businessType, businessRecordId])
  @@index([signerId])
  @@map("signatures")
}

model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.Text
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_configs")
}

model NotificationLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey String?   @unique @map("dedupe_key") @db.VarChar(160)
  userId    String    @map("user_id") @db.Uuid
  senderId  String?   @map("sender_id") @db.Uuid
  taskId    String?   @map("task_id") @db.Uuid
  cycleId   String?   @map("cycle_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  content   String?   @db.Text
  channel   String    @default("dingtalk") @db.VarChar(20)
  status    String    @default("pending") @db.VarChar(20)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  extraData Json?     @map("extra_data") @db.JsonB
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  errorMsg  String?   @map("error_msg") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User             @relation("NotifReceiver", fields: [userId], references: [id], onDelete: Cascade)
  sender User?            @relation("NotifSender", fields: [senderId], references: [id], onDelete: SetNull)
  task   AssessmentTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  cycle  AssessmentCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "notification_logs_inbox_recent_idx")
  @@index([userId, isRead, createdAt(sort: Desc), id(sort: Desc)], map: "notification_logs_inbox_unread_idx")
  @@index([status])
  @@map("notification_logs")
}

// -----------------------------------------------------------------------------
// 目标地图（E1）
// -----------------------------------------------------------------------------

model Objective {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String                @db.VarChar(200)
  description        String?               @db.Text
  level              ObjectiveLevel
  deptId             String?               @map("dept_id") @db.Uuid
  ownerId            String?               @map("owner_id") @db.Uuid
  parentId           String?               @map("parent_id") @db.Uuid
  cycleId            String?               @map("cycle_id") @db.Uuid
  weight             Decimal?              @db.Decimal(5, 2)
  priority           Int                   @default(0)
  progress           Int                   @default(0) @db.SmallInt
  status             ObjectiveStatus       @default(active)
  reviewStatus       ObjectiveReviewStatus @default(not_required) @map("review_status")
  relatedIndicatorId String?               @map("related_indicator_id") @db.Uuid
  createdBy          String?               @map("created_by") @db.Uuid
  reviewedById       String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewComment      String?               @map("review_comment") @db.Text
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)

  dept                         Department?                   @relation("ObjectiveDepartment", fields: [deptId], references: [id], onDelete: SetNull)
  owner                        User?                         @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent                       Objective?                    @relation("ObjectiveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                     Objective[]                   @relation("ObjectiveTree")
  cycle                        AssessmentCycle?              @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  relatedIndicator             Indicator?                    @relation(fields: [relatedIndicatorId], references: [id], onDelete: SetNull)
  creator                      User?                         @relation("ObjectiveCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewedBy                   User?                         @relation("ObjectiveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  actionItems                  ActionItem[]
  indicatorObjectiveAlignments IndicatorObjectiveAlignment[]

  @@index([level])
  @@index([deptId])
  @@index([ownerId])
  @@index([parentId])
  @@index([cycleId])
  @@index([status])
  @@index([reviewStatus])
  @@index([reviewedById])
  @@index([relatedIndicatorId])
  @@index([createdBy])
  @@map("objectives")
}

// -----------------------------------------------------------------------------
// 行动计划（E2）
// -----------------------------------------------------------------------------

model ActionItem {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectiveId String           @map("objective_id") @db.Uuid
  title       String           @db.VarChar(200)
  description String?          @db.Text
  assigneeId  String?          @map("assignee_id") @db.Uuid
  startDate   DateTime?        @map("start_date") @db.Date
  dueDate     DateTime?        @map("due_date") @db.Date
  status      ActionItemStatus @default(todo)
  parentId    String?          @map("parent_id") @db.Uuid
  progress    Int              @default(0) @db.SmallInt
  createdBy   String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  objective Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  assignee  User?        @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent    ActionItem?  @relation("ActionItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ActionItem[] @relation("ActionItemTree")
  creator   User?        @relation("ActionItemCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([objectiveId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([status])
  @@index([createdBy])
  @@map("action_items")
}
